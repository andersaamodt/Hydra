#!/bin/sh
set -eu

repo=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
version=$(sed -n '1p' "$repo/VERSION")
spec_version=${version%.*}

[ "$version" = "$(sed -n 's/^version = "\([^"]*\)"/\1/p' "$repo/Cargo.toml" | head -n 1)" ]
[ "$version" = "$(jq -r '.version' "$repo/apps/desktop/tauri/tauri.conf.json")" ]
[ "$version" = "$(jq -r '.version' "$repo/package.json")" ]

grep -q "## $version" "$repo/CHANGELOG.md"
grep -q "^# Hydra $spec_version Product and Protocol Specification$" "$repo/docs/AUTHORITATIVE_SPEC.md"
grep -q '^project_id=hydra$' "$repo/wizardry.workspace.conf"
grep -q '^project_type=native-desktop$' "$repo/wizardry.workspace.conf"
grep -q '^development_context=native-desktop$' "$repo/wizardry.workspace.conf"
grep -q '^targets=macos$' "$repo/wizardry.workspace.conf"
grep -q '^native_ir_path=app-blueprint/app.ir.yaml$' "$repo/wizardry.workspace.conf"
grep -q '^run_rebuild_command=npm run build$' "$repo/wizardry.workspace.conf"
grep -q '^native_macos_bundle_command=sh tools/forge/stage-macos-bundle$' "$repo/wizardry.workspace.conf"
jq -e '
  .version == "native-desktop-ir/v1" and
  .format == "yaml-1.2-json-compatible" and
  .app.targets == ["macos"] and
  .app.window == {"id":"window.main","type":"Window"} and
  .extensions == []
' "$repo/app-blueprint/app.ir.yaml" >/dev/null
[ "$(jq -r '.app.id' "$repo/app-blueprint/app.ir.yaml")" = \
  "$(sed -n 's/^name = "\([^"]*\)"/\1/p' "$repo/apps/desktop/tauri/Cargo.toml" | head -n 1)" ]
[ "$(jq -r '.app.name' "$repo/app-blueprint/app.ir.yaml")" = \
  "$(jq -r '.productName' "$repo/apps/desktop/tauri/tauri.conf.json")" ]
[ "$(jq -r '.app.targets | join(",")' "$repo/app-blueprint/app.ir.yaml")" = \
  "$(sed -n 's/^targets=//p' "$repo/wizardry.workspace.conf")" ]

for icon in \
  "$repo/assets/forge-icon.png" \
  "$repo/assets/icons/macos/forge.icns" \
  "$repo/assets/icons/linux/512x512/forge-icon.png" \
  "$repo/assets/icons/web/icon-512.png" \
  "$repo/apps/desktop/tauri/icons/icon.icns" \
  "$repo/apps/desktop/tauri/icons/icon.ico" \
  "$repo/hydra-ui/hydra-icon.png"
do
  [ -s "$icon" ]
done

cmp "$repo/assets/icons/linux/512x512/forge-icon.png" "$repo/apps/desktop/tauri/icons/icon.png"
cmp "$repo/assets/icons/web/icon-512.png" "$repo/hydra-ui/hydra-icon.png"
jq -e '.bundle.icon | index("icons/icon.icns") and index("icons/icon.ico")' \
  "$repo/apps/desktop/tauri/tauri.conf.json" >/dev/null

for script in \
  "$repo/tools/forge/stage-macos-bundle" \
  "$repo/tools/package/build-macos-app" \
  "$repo/tools/package/build-linux-deb"
do
  [ -x "$script" ]
  sh -n "$script"
done

grep -q 'tools/package/build-macos-app' "$repo/.github/workflows/ci.yml"
grep -q 'tools/forge/stage-macos-bundle' "$repo/.github/workflows/ci.yml"
grep -q 'HYDRA_MACOS_SIGNING_IDENTITY' "$repo/tools/forge/stage-macos-bundle"
grep -q 'WIZARDRY_CODESIGN_IDENTITY' "$repo/tools/forge/stage-macos-bundle"
grep -q 'Artificer Local Development Code Signing' "$repo/tools/forge/stage-macos-bundle"
grep -q 'security find-certificate' "$repo/tools/forge/stage-macos-bundle"
grep -q -- '--identifier org.hydra.desktop.runtime' "$repo/tools/forge/stage-macos-bundle"
grep -q 'tools/package/build-linux-deb' "$repo/.github/workflows/ci.yml"
grep -q 'npx tauri build --bundles nsis' "$repo/.github/workflows/ci.yml"
if grep -Eq 'apps/desktop/(macos|linux)' "$repo/.github/workflows/ci.yml"; then
  echo "CI still references an abandoned desktop shell" >&2
  exit 1
fi

git -C "$repo" rev-parse --is-inside-work-tree >/dev/null
git -C "$repo" ls-files | while IFS= read -r path; do
  case "$path" in
    target/*|dist/*|*/.build/*|node_modules/*|*.log|*.sqlite|*.sqlite3|*.db|.env|.env.*)
      printf 'tracked release pollution: %s\n' "$path" >&2
      exit 1
      ;;
  esac
done
