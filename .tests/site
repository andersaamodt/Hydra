#!/bin/sh
set -eu

repo_root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
site_root="$repo_root/site"

for file in \
  "$site_root/index.html" \
  "$site_root/how/index.html" \
  "$site_root/download/index.html" \
  "$site_root/assets/style.css" \
  "$site_root/assets/site.js" \
  "$site_root/assets/hydra-icon.png" \
  "$site_root/assets/favicon.png" \
  "$site_root/assets/fonts/figtree-latin.woff2" \
  "$site_root/assets/fonts/OFL.txt" \
  "$site_root/.nojekyll"
do
  [ -f "$file" ] || {
    printf '%s\n' "site: missing ${file#"$repo_root/"}" >&2
    exit 1
  }
done

node --check "$site_root/assets/site.js"

for page in "$site_root/index.html" "$site_root/how/index.html" "$site_root/download/index.html"
do
  grep -q '<meta name="viewport"' "$page"
  grep -q '<meta name="description"' "$page"
  grep -q '<meta http-equiv="Content-Security-Policy"' "$page"
  grep -q '<a class="skip-link" href="#main">' "$page"
  grep -q '<main id="main">' "$page"
  grep -q 'assets/style.css' "$page"
  grep -q 'assets/site.js' "$page"
  if grep -Eq 'https?://[^" ]+\.(css|js)' "$page"; then
    printf '%s\n' "site: remote executable dependency in ${page#"$repo_root/"}" >&2
    exit 1
  fi
  grep -Eo '(href|src)="[^"]+"' "$page" | sed 's/^[^=]*="//; s/"$//' | while IFS= read -r reference
  do
    case "$reference" in
      http://*|https://*|\#*) continue ;;
    esac
    file_reference=$(printf '%s' "$reference" | sed 's/[?#].*$//')
    local_path=$(CDPATH='' cd -- "$(dirname -- "$page")" && pwd)/$file_reference
    [ -e "$local_path" ] || {
      printf '%s\n' "site: broken local reference $reference in ${page#"$repo_root/"}" >&2
      exit 1
    }
  done
done

if find "$site_root" -type f \( -name '*.html' -o -name '*.css' -o -name '*.js' \) -exec \
  grep -Eiq '(^|[^[:alnum:]_])(react|vue|svelte|nextjs|jekyll|bootstrap|tailwind)([^[:alnum:]_]|$)' {} +; then
  printf '%s\n' 'site: unexpected framework or styling dependency' >&2
  exit 1
fi

if find "$site_root" -type f -name '*.html' -exec grep -Eq '(href|src)="/assets/' {} +; then
  printf '%s\n' 'site: root-relative asset path would break the GitHub project URL' >&2
  exit 1
fi

printf '%s\n' 'site: static website checks passed'
