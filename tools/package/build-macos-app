#!/bin/sh
set -eu

repo=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
[ "$(uname -s)" = Darwin ] || { echo "macOS packaging must run on macOS" >&2; exit 1; }
cd "$repo"
npm run build
find "${CARGO_TARGET_DIR:-$HOME/.local/state/cargo-targets}/release/bundle" -maxdepth 3 \
  \( -name 'Hydra.app' -o -name 'Hydra_*.dmg' \) -print
