#!/bin/sh
# Stage Hydra's canonical Tauri bundle at App Forge's requested path.
set -eu

PATH=/usr/bin:/bin:/usr/sbin:/sbin${PATH:+:$PATH}
export PATH

repo=$(CDPATH= cd -- "$(dirname "$0")/../.." && pwd)
destination=${WIZARDRY_NATIVE_MACOS_BUNDLE_PATH-}
case "$destination" in
  /*/Hydra.app) ;;
  *)
    printf '%s\n' "stage-macos-bundle: App Forge output must be an absolute Hydra.app path" >&2
    exit 2
    ;;
esac

for tool in cargo node ditto codesign; do
  command -v "$tool" >/dev/null 2>&1 || {
    printf '%s\n' "stage-macos-bundle: $tool not found" >&2
    exit 127
  }
done

target_dir=$(cargo metadata --manifest-path "$repo/Cargo.toml" --no-deps --format-version 1 |
  node -e 'let value="";process.stdin.on("data",chunk=>value+=chunk).on("end",()=>process.stdout.write(JSON.parse(value).target_directory))')
source_bundle="$target_dir/release/bundle/macos/Hydra.app"
[ -d "$source_bundle" ] || {
  printf '%s\n' "stage-macos-bundle: Tauri release bundle not found at $source_bundle" >&2
  exit 1
}
[ -x "$source_bundle/Contents/MacOS/hydra-desktop" ] || {
  printf '%s\n' "stage-macos-bundle: Tauri release executable is unavailable" >&2
  exit 1
}

destination_parent=$(dirname "$destination")
mkdir -p "$destination_parent"
staging=$(mktemp -d "$destination_parent/.hydra-forge.XXXXXX")
cleanup() {
  find "$staging" -depth -delete 2>/dev/null || true
}
trap cleanup EXIT HUP INT TERM

ditto "$source_bundle" "$staging/Hydra.app"
runtime="$staging/Hydra.app/Contents/MacOS/hydra-runtime"
[ -x "$runtime" ] || {
  printf '%s\n' "stage-macos-bundle: Hydra runtime sidecar is unavailable" >&2
  exit 1
}
identity=${HYDRA_MACOS_SIGNING_IDENTITY-}
if [ -n "$identity" ]; then
  codesign --force --sign "$identity" \
    --identifier org.hydra.desktop.runtime \
    --options runtime --timestamp=none "$runtime"
  codesign --force --sign "$identity" \
    --identifier org.hydra.desktop \
    --options runtime --timestamp=none \
    --preserve-metadata=entitlements "$staging/Hydra.app"
fi
codesign --verify --deep --strict --verbose=2 "$staging/Hydra.app"
if [ -e "$destination" ] || [ -L "$destination" ]; then
  find "$destination" -depth -delete
fi
mv "$staging/Hydra.app" "$destination"
rmdir "$staging"
trap - EXIT HUP INT TERM

[ -x "$destination/Contents/MacOS/hydra-desktop" ]
