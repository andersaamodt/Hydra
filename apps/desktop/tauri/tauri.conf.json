{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hydra",
  "version": "1.0.0",
  "identifier": "org.hydra.desktop",
  "build": {
    "frontendDist": "../../../hydra-ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Hydra — I’m with the banned.",
        "width": 1320,
        "height": 840,
        "minWidth": 940,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: data:; media-src 'self' asset: data:; style-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/hydra-runtime"],
    "category": "SocialNetworking",
    "shortDescription": "The underground Reddit alternative.",
    "longDescription": "A local-first Nostr discussion application for durable communities, memory, and exit from platform control.",
    "copyright": "Copyright © 2026 Hydra contributors",
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["hydra"]
      }
    }
  }
}
